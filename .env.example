# Copy this file to backend/.env for local development.
# None of these are required to run the app locally — every value has a
# working default that keeps everything self-contained on your machine
# (local file uploads instead of S3, console-logged "emails" instead of SES,
# and a local backend/data/*.json write instead of a GitHub commit).

# --- AWS S3 (project image uploads) ---
AWS_REGION=us-east-1
S3_BUCKET=portfolio-images-dev
USE_LOCAL_STORAGE=true
LOCAL_UPLOAD_DIR=uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- AWS SES (contact form emails) ---
SES_SENDER_EMAIL=noreply@example.com
SES_RECIPIENT_EMAIL=your-email@example.com
USE_LOCAL_EMAIL=true

# --- Admin auth ---
ADMIN_PASSWORD=admin123
SECRET_KEY=dev-secret-key-change-in-production

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Data store (backend/data/*.json, committed via GitHub) ---
# Only needed in production (Vercel) — without a token, admin writes just
# save to the local file, which is exactly what you want for local dev.
# GITHUB_TOKEN should be a fine-grained personal access token scoped to
# just this repo with "Contents: Read and write" permission.
# GITHUB_TOKEN=
GITHUB_REPO=LukeSheely/portfolio-website
GITHUB_BRANCH=main
